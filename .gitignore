# ---------- Build output ----------
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
artifacts/

# ---------- Release payloads ----------
# Releases live outside ProjectFiles so a disk cleanup of the source tree still
# leaves a working build. Nothing in here is versioned.
(Releases)/

# ---------- Local scaffolding, not source ----------
# Personal project-management helpers and notes. Never publish these.
ZZZ_Metadata/
(Belongs_to)/
___Notes/
*.code-workspace
_Move_project_to_GDrive.py
_Create_or_check_databases_folder_existence.py

# ---------- Windows shell cruft ----------
*.lnk
*.url
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Local machine state ----------
# Chromecast pairing/session state and any dev certs must never be committed.
*.pfx
*.snk
appsettings.Local.json
.env
devices.local.json

# ---------- Brand raster exports ----------
# SVG sources are the truth; PNG/ICO are generated by brand/build-assets.sh.
# Only the packaged app icon is tracked.
brand/export/*
!brand/export/.gitkeep
# README embeds these two, so they must be tracked.
!brand/export/logo-horizontal.png
!brand/export/logo-horizontal-dark.png

# ---------- Test output ----------
TestResults/

# ---------- Generated media fixtures ----------
# Rebuild with tools/make-test-pattern.sh; not worth versioning a video blob.
ProjectFiles/assets/*.h264
